{
    "name": "survos/duckdb-api-bundle",
    "description": "Read-only API Platform 5 state provider for explicitly mapped DuckDB resources over native PDO.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "api-platform",
        "duckdb",
        "pdo"
    ],
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "ext-pdo_duckdb": "*",
        "api-platform/core": "^5.0",
        "survos/kit-bundle": "^2.36",
        "symfony/framework-bundle": "^8.1",
        "symfony/serializer": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Survos\\DuckDbApiBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Survos\\DuckDbApiBundle\\Tests\\": "tests/"
        }
    }
}
